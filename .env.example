# Copy to .env and fill in. Never commit .env.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=www.bookyourielts.com,bookyourielts.com,base.bookyourielts.com
FRONTEND_URL=https://www.bookyourielts.com
CORS_ALLOWED_ORIGINS=https://www.bookyourielts.com
CSRF_TRUSTED_ORIGINS=https://www.bookyourielts.com,https://base.bookyourielts.com
# Empty: one host only, so the login cookie stays on www.bookyourielts.com.
COOKIE_DOMAIN=
# Optional: raise while load testing or running e2e against a shared server (default 5/hour per visitor).
# INQUIRY_RATE=5/hour
# AUTH_RATE=20/min  # login, register and password reset attempts per visitor
WEB_CONCURRENCY=3
LOG_LEVEL=INFO

# --- Database (used by deploy/docker-compose.db.yml and the app) ---
POSTGRES_USER=bookyourielts
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookyourielts
# For local development outside Docker (the dev compose file maps Postgres to port 5433):
# DATABASE_URL=postgres://bookyourielts:bookyourielts@127.0.0.1:5433/bookyourielts

# --- WhatsApp: digits only, with country code, no + sign. Editable later in Admin > Site settings ---
ADMIN_WHATSAPP_NUMBER=9779860688212

# --- Email (the console backend is used when EMAIL_HOST is empty) ---
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_USER=<address>, EMAIL_HOST_PASSWORD=<16-character app password>.
# Check it with: python manage.py send_test_email you@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Who is told about every new booking request (comma separated).
ADMIN_NOTIFY_EMAILS=sabinbaniya73@gmail.com
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=bookyourielts.com <no-reply@bookyourielts.com>

# --- Cloudflare R2 media (only needed once you add uploads) ---
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Frontend ---
NEXT_PUBLIC_SITE_URL=https://www.bookyourielts.com
# Leave empty: the whole site, including the student portal (/portal), is served from www.bookyourielts.com.
# Set it only if you later move the portal to its own subdomain.
NEXT_PUBLIC_APP_URL=
# Where Next.js proxies /api/*. The compose file points it at the backend container; use localhost:8000 in dev.
API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_WHATSAPP_NUMBER=9779860688212

# Google Analytics measurement id (production builds only)
NEXT_PUBLIC_GA_ID=G-DFESYKD5QR
